<?xml version="1.0" encoding="utf-8"?>
<!-- Form nhập bài viết (màn hình dọc). ID các View phải giống layout-land/activity_main.xml -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/main"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_dark"
  tools:context=".MainActivity">

  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/app_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_nav"
    app:liftOnScroll="false">

    <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/toolbar"
      style="@style/Widget.App.Toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      app:subtitle="@string/form_subtitle"
      app:title="@string/form_title" />

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="@color/border" />

    <!-- Chỉ hiện khi đang lưu -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
      android:id="@+id/progress_saving"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:indeterminate="true"
      android:visibility="invisible"
      app:indicatorColor="@color/accent"
      app:trackColor="@android:color/transparent" />
  </com.google.android.material.appbar.AppBarLayout>

  <androidx.core.widget.NestedScrollView
    android:id="@+id/form_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="16dp"
      android:paddingTop="20dp"
      android:paddingEnd="16dp"
      android:paddingBottom="24dp">

      <!-- Thẻ số xem trước: đổi theo số bài viết đang nhập -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/txt_plate_preview"
          style="@style/Widget.App.Chip.Large"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/tag_placeholder" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="16dp"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plate_caption_title"
            android:textAppearance="@style/TextAppearance.App.Heading" />

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/plate_caption_body"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/text_muted" />
        </LinearLayout>
      </LinearLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_article_id"
        style="@style/Widget.App.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/label_article_id"
        app:helperText="@string/helper_article_id">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etArticleId"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:imeOptions="actionNext"
          android:importantForAutofill="no"
          android:inputType="number" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_article_title"
        style="@style/Widget.App.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/label_article_title">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etArticleTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:imeOptions="actionNext"
          android:importantForAutofill="no"
          android:inputType="text|textCapSentences" />
      </com.google.android.material.textfield.TextInputLayout>
      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_article_author"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.App.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/label_article_author">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etArticleAuthor"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:imeOptions="actionNext"
          android:importantForAutofill="no"
          android:inputType="text|textCapWords" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_article_image"
        style="@style/Widget.App.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/label_article_image"
        app:helperText="@string/helper_article_image">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etArticleImage"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:imeOptions="actionNext"
          android:importantForAutofill="no"
          android:inputType="textUri" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_article_description"
        style="@style/Widget.App.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/label_article_description">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etArticleDescription"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="top|start"
          android:importantForAutofill="no"
          android:inputType="textMultiLine|textCapSentences"
          android:minLines="4" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btAdd"
        style="@style/Widget.App.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/add_article" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btShow"
        style="@style/Widget.App.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/show_articles" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
